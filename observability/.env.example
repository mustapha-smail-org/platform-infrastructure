# ── CityPulse · Observability (Grafana Alloy) · env file ──────────────────
# Copy to observability/.env on the VPS. All values come from your Grafana Cloud
# stack (free tier). Never commit the real .env.
#
# In Grafana Cloud: create ONE Access Policy token with scopes
#   logs:write  +  metrics:write
# and use it as GRAFANA_CLOUD_TOKEN below. The Loki/Prometheus push URLs and the
# numeric user IDs are shown on each data source's "Details / Send" page.

# Loki (logs)
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=000000

# Prometheus (metrics)
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-xxx.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=000000

# One Access Policy token, used as the password for both.
GRAFANA_CLOUD_TOKEN=glc_replace_me
