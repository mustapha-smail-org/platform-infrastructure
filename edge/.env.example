# ── CityPulse · EDGE (Caddy) · env file ───────────────────────────────────
# Copy to edge/.env on the VPS.

# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# Public hostnames per environment. Placeholders until the domain is bought —
# see the note at the top of edge/Caddyfile for the pre-domain options
# (nip.io, or `:80` + `tls internal` for local testing).
PROD_APP_HOST=citypulse.example.com
STAGING_APP_HOST=staging.citypulse.example.com
